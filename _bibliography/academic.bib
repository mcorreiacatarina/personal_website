@article{midoes2026synergies,
  title    = {Synergies and Welfare Effects of Combining Carbon Pricing and Renewable-Energy Policies: A Meta-Analysis},
  author   = {Midões, Catarina and {van den Bergh}, J. and Savin, I. and {de Alessandri}, G.},
  journal  = {Environmental and Resource Economics},
  year     = {2026},
  note     = {Accepted 9 July 2026, forthcoming},
  doi      = {10.1007/s10640-026-01098-x},
  abstract = {Despite microeconomic theory advising against their combination, a cross-sectional econometric analysis of quantitative estimates of synergies shows that in the presence of fossil fuel subsidies, policy uncertainty, limited transfers and consumer-oriented welfare measures, their combination is a reasonable policy choice.}
}

@article{midoes2024shareenv,
  title    = {SHARE-ENV: A Data Set to Advance Our Knowledge of the Environment--Wellbeing Relationship},
  author   = {Midões, Catarina and {De Cian}, E. and Pasini, G. and Pesenti, S. and Mistry, M. N.},
  journal  = {Environment and Health},
  year     = {2024},
  volume   = {2},
  number   = {2},
  pages    = {95--104},
  doi      = {10.1021/envhealth.3c00065},
  abstract = {Household panel dataset and cross-sectional econometric analysis confirm that a new dataset allows for numerous policy-relevant analyses without the need for additional geospatial granularity of environmental information.}
}

@article{midoes2023assumptionlight,
  title    = {Assumption-light and computationally cheap inference on inequality measures by sample splitting: the Student-t approach},
  author   = {Midões, Catarina and {de Crombrugghe}, D.},
  journal  = {Journal of Economic Inequality},
  year     = {2023},
  volume   = {21},
  pages    = {899--924},
  doi      = {10.1007/s10888-023-09574-w},
  abstract = {Through asymptotic analysis and Monte-Carlo simulations, with an application to Russian household income datasets, it is shown that a statistical test other than those regularly in use would allow for better detection of differences in inequality across time and space.}
}

@article{midoes2022living,
  title    = {Living with reduced income: An analysis of financial vulnerability under COVID-19},
  author   = {Midões, Catarina and Seré, M.},
  journal  = {Social Indicators Research},
  year     = {2022},
  volume   = {161},
  pages    = {125--149},
  doi      = {10.1007/s11205-021-02811-7},
  abstract = {Through a new vulnerability index and a tax-benefit micro-simulation model, income support appears crucial to ensure basic expenses to large portions of the population during work stoppages, while rent and mortgage suspension efficacy is country-dependent.}
}
